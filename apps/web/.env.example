# From your Supabase project's Settings -> API page.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables the "enable notifications" prompt. Generate with:
#   npx web-push generate-vapid-keys
# (only the public key goes in the frontend; keep the private key server-side,
# see supabase/functions/send-push/README for where it's used)
VITE_VAPID_PUBLIC_KEY=
