PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/vialove.db
COOKIE_SECURE=false

# Optional — any SMTP provider works (Gmail, SendGrid, Resend, Postmark, SES,
# Mailtrap for testing, ...). Leave unset in local dev: password-reset emails
# are logged to the server console instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=vialove <no-reply@vialove.app>
